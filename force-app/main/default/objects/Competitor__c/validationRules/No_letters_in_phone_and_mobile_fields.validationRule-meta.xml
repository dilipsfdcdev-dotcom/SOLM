<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>No_letters_in_phone_and_mobile_fields</fullName>
    <active>true</active>
    <errorConditionFormula>REGEX( Phone__c , &quot;(?=.*[a-zA-Z]).*$&quot;)</errorConditionFormula>
    <errorMessage>Do not use letters in Phone field.</errorMessage>
</ValidationRule>
