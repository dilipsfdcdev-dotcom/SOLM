<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Time_In_On_Hold__c</fullName>
    <businessStatus>DeprecateCandidate</businessStatus>
    <externalId>false</externalId>
    <formula>IF(ISNULL(Case_On_Hold_Date__c), 0, (Case_Closed_Date__c - Case_On_Hold_Date__c) *24*60)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Time In On Hold (Minutes)</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
