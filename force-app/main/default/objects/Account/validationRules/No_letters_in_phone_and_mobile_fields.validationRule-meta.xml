<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>No_letters_in_phone_and_mobile_fields</fullName>
    <active>true</active>
    <errorConditionFormula>REGEX( Phone , &quot;(?=.*[a-zA-Z]).*$&quot;)
&amp;&amp; ISBLANK( SAP_Code__c )</errorConditionFormula>
    <errorMessage>Do not use letters in Phone fields.</errorMessage>
</ValidationRule>
