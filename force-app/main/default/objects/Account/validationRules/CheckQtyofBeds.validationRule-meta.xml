<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>CheckQtyofBeds</fullName>
    <active>false</active>
    <errorConditionFormula>AND (
NOT(ISPICKVAL(Hospital_Type__c, &quot;&quot;)),
 Bed_Count__c &lt; 1
)</errorConditionFormula>
    <errorDisplayField>Bed_Count__c</errorDisplayField>
    <errorMessage>Please, indicate the quantity of beds for this Hospital.</errorMessage>
</ValidationRule>
