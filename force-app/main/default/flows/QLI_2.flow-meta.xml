<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>What_Changed</name>
        <label>What Changed</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>If_Sales_price_changed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.UnitPrice</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Sales_Price_Linked_data</targetReference>
            </connector>
            <label>If Sales price changed</label>
        </rules>
        <rules>
            <name>If_GP_Changed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.GPPercentage__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_GP_Linked</targetReference>
            </connector>
            <label>If GP% Changed</label>
        </rules>
    </decisions>
    <description>(Depricated)</description>
    <environments>Default</environments>
    <formulas>
        <name>GPDollars</name>
        <dataType>Currency</dataType>
        <expression>({!$Record.UnitPrice} - {!Get_StandardCost.Standard_Cost__c} ) * {!$Record.Quantity}</expression>
        <scale>5</scale>
    </formulas>
    <formulas>
        <name>GPPercent</name>
        <dataType>Number</dataType>
        <expression>((({!$Record.UnitPrice} - {!Get_StandardCost.Standard_Cost__c} ) / {!$Record.UnitPrice})) * 100</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>PriceperBox</name>
        <dataType>Currency</dataType>
        <expression>{!$Record.Product2.NACA_Box_Quantity__c} * {!$Record.UnitPrice}</expression>
        <scale>6</scale>
    </formulas>
    <formulas>
        <name>PriceperCase</name>
        <dataType>Currency</dataType>
        <expression>{!$Record.Product2.NACA_Case_Qty__c} * {!$Record.UnitPrice}</expression>
        <scale>6</scale>
    </formulas>
    <formulas>
        <name>QtyboxCase</name>
        <dataType>String</dataType>
        <expression>TEXT({!$Record.Product2.NACA_Box_Quantity__c}) &amp; &quot;/&quot; &amp; TEXT({!$Record.Product2.NACA_Case_Qty__c})</expression>
    </formulas>
    <formulas>
        <name>SalesPrice</name>
        <dataType>Currency</dataType>
        <expression>{!Get_StandardCost.Standard_Cost__c} / (1 - ({!$Record.GPPercentage__c} / 100))</expression>
        <scale>5</scale>
    </formulas>
    <formulas>
        <name>TotalPrice</name>
        <dataType>Currency</dataType>
        <expression>{!$Record.UnitPrice} * {!$Record.Quantity}</expression>
        <scale>5</scale>
    </formulas>
    <interviewLabel>QLI 2 {!$Flow.CurrentDateTime}</interviewLabel>
    <label>QLI - Before Insert/Update (Depricated)</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Quote</name>
        <label>Get Quote</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_StandardCost</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Quote.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Quote</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_StandardCost</name>
        <label>Get StandardCost</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>What_Changed</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Name</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Product2.ProductCode</elementReference>
            </value>
        </filters>
        <filters>
            <field>Incoterms__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Quote.Incoterm__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Standard_Price__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_GP_Linked</name>
        <label>Update GP Linked</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>UnitPrice</field>
            <value>
                <elementReference>SalesPrice</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Sales_Price_Linked_data</name>
        <label>Update Sales Price Linked data</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>GPDollar__c</field>
            <value>
                <elementReference>GPDollars</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>GPPercentage__c</field>
            <value>
                <elementReference>GPPercent</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Price_per_Box__c</field>
            <value>
                <elementReference>PriceperBox</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Price_per_Case__c</field>
            <value>
                <elementReference>PriceperCase</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Qty_box_Case__c</field>
            <value>
                <elementReference>QtyboxCase</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Standard_Cost__c</field>
            <value>
                <elementReference>Get_StandardCost.Standard_Cost__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Total_Price__c</field>
            <value>
                <elementReference>TotalPrice</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>null__NotFound</field>
            <value>
                <elementReference>Get_Quote.Incoterm__c</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Quote</targetReference>
        </connector>
        <object>QuoteLineItem</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>InvalidDraft</status>
</Flow>
