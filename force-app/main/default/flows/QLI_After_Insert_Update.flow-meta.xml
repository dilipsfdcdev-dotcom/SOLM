<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Check_any_Quote_is_Present</name>
        <label>Check any Quote is Present</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Quote.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_StandardCost</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_If_Standard_Cost_Present</name>
        <label>Check If Standard Cost Present</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>If_Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_StandardCost.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_QLI</targetReference>
            </connector>
            <label>If Yes</label>
        </rules>
    </decisions>
    <description>To get QLI Margin Simulation details</description>
    <environments>Default</environments>
    <formulas>
        <name>GPDollars</name>
        <dataType>Currency</dataType>
        <expression>({!$Record.UnitPrice} - {!Get_StandardCost.Standard_Cost__c} ) * {!$Record.Quantity}</expression>
        <scale>5</scale>
    </formulas>
    <formulas>
        <name>GPPercent</name>
        <dataType>Number</dataType>
        <expression>((({!$Record.UnitPrice} - {!Get_StandardCost.Standard_Cost__c} ) / {!$Record.UnitPrice})) * 100</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>PriceperBox</name>
        <dataType>Currency</dataType>
        <expression>{!$Record.Product2.NACA_Box_Quantity__c} * {!$Record.UnitPrice}</expression>
        <scale>5</scale>
    </formulas>
    <formulas>
        <name>PriceperCase</name>
        <dataType>Currency</dataType>
        <expression>{!$Record.Product2.NACA_Case_Qty__c} * {!$Record.UnitPrice}</expression>
        <scale>5</scale>
    </formulas>
    <formulas>
        <name>QtyboxCase</name>
        <dataType>String</dataType>
        <expression>TEXT({!$Record.Product2.NACA_Box_Quantity__c}) &amp; &quot;/&quot; &amp; TEXT({!$Record.Product2.NACA_Case_Qty__c})</expression>
    </formulas>
    <formulas>
        <name>TotalPrice</name>
        <dataType>Currency</dataType>
        <expression>{!$Record.UnitPrice} * {!$Record.Quantity}</expression>
        <scale>6</scale>
    </formulas>
    <interviewLabel>QLI - After Insert/Update {!$Flow.CurrentDateTime}</interviewLabel>
    <label>QLI - After Insert/Update</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Quote</name>
        <label>Get Quote</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_any_Quote_is_Present</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Quote.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Quote</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_StandardCost</name>
        <label>Get StandardCost</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_If_Standard_Cost_Present</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>ItemCode__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Product2.ProductCode</elementReference>
            </value>
        </filters>
        <filters>
            <field>Incoterms__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Quote.Incoterm__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Standard_Price__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_QLI</name>
        <label>Update QLI</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>GPDollar__c</field>
            <value>
                <elementReference>GPDollars</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>GPPercentage__c</field>
            <value>
                <elementReference>GPPercent</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Incoterm__c</field>
            <value>
                <elementReference>Get_Quote.Incoterm__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Price_per_Box__c</field>
            <value>
                <elementReference>PriceperBox</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Price_per_Case__c</field>
            <value>
                <elementReference>PriceperCase</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Qty_box_Case__c</field>
            <value>
                <elementReference>QtyboxCase</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Standard_Cost__c</field>
            <value>
                <elementReference>Get_StandardCost.Standard_Cost__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Total_Price__c</field>
            <value>
                <elementReference>TotalPrice</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Quote</targetReference>
        </connector>
        <object>QuoteLineItem</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
