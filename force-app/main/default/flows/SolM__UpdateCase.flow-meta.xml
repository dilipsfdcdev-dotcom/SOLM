<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <description>Updates one or more fields (status, priority, description) on an existing Case. Used by Agentforce IT Helpdesk Agent.</description>
    <label>SolM Update Case</label>
    <processType>AutoLaunchedFlow</processType>
    <status>Active</status>

    <variables>
        <n>caseId</n>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <n>status</n>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <n>priority</n>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <n>description</n>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <n>caseRecord</n>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
        <objectType>Case</objectType>
    </variables>
    <variables>
        <n>isSuccess</n>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
        <value><booleanValue>false</booleanValue></value>
    </variables>
    <variables>
        <n>errorMessage</n>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>

    <start>
        <locationX>50</locationX>
        <locationY>50</locationY>
        <connector><targetReference>Validate_CaseId</targetReference></connector>
    </start>

    <decisions>
        <n>Validate_CaseId</n>
        <label>Validate CaseId</label>
        <locationX>200</locationX>
        <locationY>150</locationY>
        <defaultConnectorLabel>Missing CaseId</defaultConnectorLabel>
        <defaultConnector><targetReference>Set_CaseId_Error</targetReference></defaultConnector>
        <rules>
            <n>CaseId_Valid</n>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>caseId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue><booleanValue>false</booleanValue></rightValue>
            </conditions>
            <connector><targetReference>Get_Existing_Case</targetReference></connector>
            <label>CaseId Provided</label>
        </rules>
    </decisions>

    <recordLookups>
        <n>Get_Existing_Case</n>
        <label>Get Existing Case</label>
        <locationX>400</locationX>
        <locationY>150</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector><targetReference>Check_Status_Update</targetReference></connector>
        <faultConnector><targetReference>Set_Lookup_Error</targetReference></faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value><elementReference>caseId</elementReference></value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Case</object>
        <outputReference>caseRecord</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>CaseNumber</queriedFields>
        <queriedFields>Subject</queriedFields>
        <queriedFields>Status</queriedFields>
        <queriedFields>Priority</queriedFields>
        <queriedFields>Description</queriedFields>
    </recordLookups>

    <!-- Conditionally update Status -->
    <decisions>
        <n>Check_Status_Update</n>
        <label>Update Status?</label>
        <locationX>600</locationX>
        <locationY>150</locationY>
        <defaultConnectorLabel>No Status Update</defaultConnectorLabel>
        <defaultConnector><targetReference>Check_Priority_Update</targetReference></defaultConnector>
        <rules>
            <n>Has_Status</n>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>status</leftValueReference>
                <operator>IsNull</operator>
                <rightValue><booleanValue>false</booleanValue></rightValue>
            </conditions>
            <conditions>
                <leftValueReference>status</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue><stringValue></stringValue></rightValue>
            </conditions>
            <connector><targetReference>Assign_Status</targetReference></connector>
            <label>Status Provided</label>
        </rules>
    </decisions>
    <assignments>
        <n>Assign_Status</n>
        <label>Assign Status</label>
        <locationX>800</locationX>
        <locationY>50</locationY>
        <assignmentItems>
            <assignToReference>caseRecord.Status</assignToReference>
            <operator>Assign</operator>
            <value><elementReference>status</elementReference></value>
        </assignmentItems>
        <connector><targetReference>Check_Priority_Update</targetReference></connector>
    </assignments>

    <decisions>
        <n>Check_Priority_Update</n>
        <label>Update Priority?</label>
        <locationX>800</locationX>
        <locationY>200</locationY>
        <defaultConnectorLabel>No Priority Update</defaultConnectorLabel>
        <defaultConnector><targetReference>Check_Description_Update</targetReference></defaultConnector>
        <rules>
            <n>Has_Priority</n>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>priority</leftValueReference>
                <operator>IsNull</operator>
                <rightValue><booleanValue>false</booleanValue></rightValue>
            </conditions>
            <conditions>
                <leftValueReference>priority</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue><stringValue></stringValue></rightValue>
            </conditions>
            <connector><targetReference>Assign_Priority</targetReference></connector>
            <label>Priority Provided</label>
        </rules>
    </decisions>
    <assignments>
        <n>Assign_Priority</n>
        <label>Assign Priority</label>
        <locationX>1000</locationX>
        <locationY>100</locationY>
        <assignmentItems>
            <assignToReference>caseRecord.Priority</assignToReference>
            <operator>Assign</operator>
            <value><elementReference>priority</elementReference></value>
        </assignmentItems>
        <connector><targetReference>Check_Description_Update</targetReference></connector>
    </assignments>

    <decisions>
        <n>Check_Description_Update</n>
        <label>Update Description?</label>
        <locationX>1000</locationX>
        <locationY>300</locationY>
        <defaultConnectorLabel>No Description Update</defaultConnectorLabel>
        <defaultConnector><targetReference>Save_Case_Record</targetReference></defaultConnector>
        <rules>
            <n>Has_Description</n>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>description</leftValueReference>
                <operator>IsNull</operator>
                <rightValue><booleanValue>false</booleanValue></rightValue>
            </conditions>
            <conditions>
                <leftValueReference>description</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue><stringValue></stringValue></rightValue>
            </conditions>
            <connector><targetReference>Assign_Description</targetReference></connector>
            <label>Description Provided</label>
        </rules>
    </decisions>
    <assignments>
        <n>Assign_Description</n>
        <label>Assign Description</label>
        <locationX>1200</locationX>
        <locationY>200</locationY>
        <assignmentItems>
            <assignToReference>caseRecord.Description</assignToReference>
            <operator>Assign</operator>
            <value><elementReference>description</elementReference></value>
        </assignmentItems>
        <connector><targetReference>Save_Case_Record</targetReference></connector>
    </assignments>

    <recordUpdates>
        <n>Save_Case_Record</n>
        <label>Save Updated Case</label>
        <locationX>1200</locationX>
        <locationY>400</locationY>
        <connector><targetReference>Set_Update_Success</targetReference></connector>
        <faultConnector><targetReference>Set_Update_Error</targetReference></faultConnector>
        <inputReference>caseRecord</inputReference>
    </recordUpdates>

    <assignments>
        <n>Set_Update_Success</n>
        <label>Set Success</label>
        <locationX>1400</locationX>
        <locationY>400</locationY>
        <assignmentItems>
            <assignToReference>isSuccess</assignToReference>
            <operator>Assign</operator>
            <value><booleanValue>true</booleanValue></value>
        </assignmentItems>
    </assignments>
    <assignments>
        <n>Set_CaseId_Error</n>
        <label>Set CaseId Error</label>
        <locationX>200</locationX>
        <locationY>350</locationY>
        <assignmentItems>
            <assignToReference>errorMessage</assignToReference>
            <operator>Assign</operator>
            <value><stringValue>Case ID is required to update a case.</stringValue></value>
        </assignmentItems>
    </assignments>
    <assignments>
        <n>Set_Lookup_Error</n>
        <label>Set Lookup Error</label>
        <locationX>400</locationX>
        <locationY>350</locationY>
        <assignmentItems>
            <assignToReference>errorMessage</assignToReference>
            <operator>Assign</operator>
            <value><stringValue>Case not found or access denied.</stringValue></value>
        </assignmentItems>
    </assignments>
    <assignments>
        <n>Set_Update_Error</n>
        <label>Set Update Error</label>
        <locationX>1200</locationX>
        <locationY>600</locationY>
        <assignmentItems>
            <assignToReference>errorMessage</assignToReference>
            <operator>Assign</operator>
            <value><elementReference>$Flow.FaultMessage</elementReference></value>
        </assignmentItems>
    </assignments>
</Flow>
