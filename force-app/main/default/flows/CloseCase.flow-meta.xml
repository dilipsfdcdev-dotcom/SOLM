<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <description>Closes a Case by updating Status to Closed and storing resolution summary, root cause, and closure notes. Used by Agentforce IT Helpdesk Agent.</description>
    <label>SolM Close Case</label>
    <processType>AutoLaunchedFlow</processType>
    <status>Active</status>

    <variables>
        <name>caseId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>resolutionSummary</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>rootCause</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>closureNotes</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>caseRecord</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
        <objectType>Case</objectType>
    </variables>
    <variables>
        <name>isSuccess</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
        <value><booleanValue>false</booleanValue></value>
    </variables>
    <variables>
        <name>errorMessage</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>

    <start>
        <locationX>50</locationX>
        <locationY>50</locationY>
        <connector><targetReference>Validate_Close_Inputs</targetReference></connector>
    </start>

    <decisions>
        <name>Validate_Close_Inputs</name>
        <label>Validate Required Inputs</label>
        <locationX>200</locationX>
        <locationY>150</locationY>
        <defaultConnectorLabel>Invalid Inputs</defaultConnectorLabel>
        <defaultConnector><targetReference>Set_Validation_Error</targetReference></defaultConnector>
        <rules>
            <name>Inputs_Valid</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>caseId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue><booleanValue>false</booleanValue></rightValue>
            </conditions>
            <conditions>
                <leftValueReference>resolutionSummary</leftValueReference>
                <operator>IsNull</operator>
                <rightValue><booleanValue>false</booleanValue></rightValue>
            </conditions>
            <conditions>
                <leftValueReference>resolutionSummary</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue><stringValue></stringValue></rightValue>
            </conditions>
            <connector><targetReference>Fetch_Case_To_Close</targetReference></connector>
            <label>Inputs Valid</label>
        </rules>
    </decisions>

    <recordLookups>
        <name>Fetch_Case_To_Close</name>
        <label>Fetch Case to Close</label>
        <locationX>400</locationX>
        <locationY>150</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector><targetReference>Check_Already_Closed</targetReference></connector>
        <faultConnector><targetReference>Set_Fetch_Error</targetReference></faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value><elementReference>caseId</elementReference></value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Case</object>
        <outputReference>caseRecord</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>CaseNumber</queriedFields>
        <queriedFields>Subject</queriedFields>
        <queriedFields>Status</queriedFields>
        <queriedFields>Priority</queriedFields>
    </recordLookups>

    <decisions>
        <name>Check_Already_Closed</name>
        <label>Is Case Already Closed?</label>
        <locationX>600</locationX>
        <locationY>150</locationY>
        <defaultConnectorLabel>Not Closed - Proceed</defaultConnectorLabel>
        <defaultConnector><targetReference>Assign_Close_Fields</targetReference></defaultConnector>
        <rules>
            <name>Already_Closed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>caseRecord.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue><stringValue>Closed</stringValue></rightValue>
            </conditions>
            <connector><targetReference>Set_Already_Closed_Error</targetReference></connector>
            <label>Case Is Already Closed</label>
        </rules>
    </decisions>

    <assignments>
        <name>Assign_Close_Fields</name>
        <label>Set Closure Fields on Case</label>
        <locationX>800</locationX>
        <locationY>150</locationY>
        <assignmentItems>
            <assignToReference>caseRecord.Status</assignToReference>
            <operator>Assign</operator>
            <value><stringValue>Closed</stringValue></value>
        </assignmentItems>
        <!-- Resolution stored in Description or a custom field — adjust field API name as needed -->
        <!-- If you have custom fields like Resolution__c, Root_Cause__c, map them here -->
        <assignmentItems>
            <assignToReference>caseRecord.Description</assignToReference>
            <operator>Assign</operator>
            <value><elementReference>resolutionSummary</elementReference></value>
        </assignmentItems>
        <connector><targetReference>Close_Case_Record</targetReference></connector>
    </assignments>

    <recordUpdates>
        <name>Close_Case_Record</name>
        <label>Close Case Record</label>
        <locationX>1000</locationX>
        <locationY>150</locationY>
        <connector><targetReference>Add_Resolution_Comment</targetReference></connector>
        <faultConnector><targetReference>Set_Close_Error</targetReference></faultConnector>
        <inputReference>caseRecord</inputReference>
    </recordUpdates>

    <!-- Add a closure comment with full resolution + root cause + notes -->
    <variables>
        <name>resolutionComment</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>newClosureComment</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>CaseComment</objectType>
    </variables>

    <assignments>
        <name>Add_Resolution_Comment</name>
        <label>Build Resolution Comment Text</label>
        <locationX>1200</locationX>
        <locationY>150</locationY>
        <assignmentItems>
            <assignToReference>resolutionComment</assignToReference>
            <operator>Assign</operator>
            <value><stringValue>CASE CLOSED - Resolution: </stringValue></value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>resolutionComment</assignToReference>
            <operator>Add</operator>
            <value><elementReference>resolutionSummary</elementReference></value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>newClosureComment.ParentId</assignToReference>
            <operator>Assign</operator>
            <value><elementReference>caseId</elementReference></value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>newClosureComment.CommentBody</assignToReference>
            <operator>Assign</operator>
            <value><elementReference>resolutionComment</elementReference></value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>newClosureComment.IsPublished</assignToReference>
            <operator>Assign</operator>
            <value><booleanValue>true</booleanValue></value>
        </assignmentItems>
        <connector><targetReference>Create_Closure_Comment</targetReference></connector>
    </assignments>

    <recordCreates>
        <name>Create_Closure_Comment</name>
        <label>Create Closure Comment</label>
        <locationX>1400</locationX>
        <locationY>150</locationY>
        <connector><targetReference>Set_Close_Success</targetReference></connector>
        <inputReference>newClosureComment</inputReference>
        <storeOutputAutomatically>false</storeOutputAutomatically>
    </recordCreates>

    <assignments>
        <name>Set_Close_Success</name>
        <label>Set Close Success</label>
        <locationX>1600</locationX>
        <locationY>150</locationY>
        <assignmentItems>
            <assignToReference>isSuccess</assignToReference>
            <operator>Assign</operator>
            <value><booleanValue>true</booleanValue></value>
        </assignmentItems>
    </assignments>

    <assignments>
        <name>Set_Validation_Error</name>
        <label>Set Validation Error</label>
        <locationX>200</locationX>
        <locationY>400</locationY>
        <assignmentItems>
            <assignToReference>errorMessage</assignToReference>
            <operator>Assign</operator>
            <value><stringValue>Case ID and resolution summary are required to close a case.</stringValue></value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Set_Already_Closed_Error</name>
        <label>Set Already Closed Error</label>
        <locationX>600</locationX>
        <locationY>400</locationY>
        <assignmentItems>
            <assignToReference>errorMessage</assignToReference>
            <operator>Assign</operator>
            <value><stringValue>This case is already closed and cannot be closed again.</stringValue></value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Set_Fetch_Error</name>
        <label>Set Fetch Error</label>
        <locationX>400</locationX>
        <locationY>400</locationY>
        <assignmentItems>
            <assignToReference>errorMessage</assignToReference>
            <operator>Assign</operator>
            <value><stringValue>Case not found or you do not have access to this case.</stringValue></value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Set_Close_Error</name>
        <label>Set Close Error</label>
        <locationX>1000</locationX>
        <locationY>400</locationY>
        <assignmentItems>
            <assignToReference>errorMessage</assignToReference>
            <operator>Assign</operator>
            <value><elementReference>$Flow.FaultMessage</elementReference></value>
        </assignmentItems>
    </assignments>
</Flow>
