    <decisions>
        <name>Case_On_Hold_end</name>
        <label>Case On Hold end</label>
        <locationX>336</locationX>
        <locationY>1187</locationY>
        <defaultConnector>
            <targetReference>CaseOnHoldstart</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Case_exits_On_Hold_status</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record__Prior.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>On Hold</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_On_Hold_Times</targetReference>
            </connector>
            <label>Case exits On Hold status</label>
        </rules>
    </decisions>
    <decisions>
        <description>Used to catch situations where Case was not assigned from Omni-Channel but manually. If not, picked time handled by flow: Agent Work - after create/update.</description>
        <name>Case_picked_up_manually</name>
        <label>Case Picked Up Manually</label>
        <locationX>336</locationX>
        <locationY>287</locationY>
        <defaultConnector>
            <targetReference>Case_Reopened</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Was_Case_Picked_Up_manually</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.OwnerId</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Owner:Group.DeveloperName</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Assigned_Status</targetReference>
            </connector>
            <label>Was Case Picked Up Manually</label>
        </rules>
    </decisions>
