    <decisions>
        <name>Is_Previous_Owner_an_User</name>
        <label>Is Previous Owner an User</label>
        <locationX>336</locationX>
        <locationY>2195</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Is_Previous_Owner_an_User_check</name>
            <conditionLogic>((2 AND 3) OR (4 AND 5) OR (4 AND 6)) AND 1</conditionLogic>
            <conditions>
                <leftValueReference>$Record__Prior.Owner:User.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.OwnerId</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Owner:User.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Reopened</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>On Hold</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Previous_Owner</targetReference>
            </connector>
            <label>Is Previous Owner an User check</label>
        </rules>
    </decisions>
    <decisions>
        <description>Picked Up time should not be set when case is exiting On Hold.</description>
        <name>Should_Set_Picked_Up_Time</name>
        <label>Should Set Picked Up Time</label>
        <locationX>182</locationX>
        <locationY>503</locationY>
        <defaultConnector>
            <targetReference>Case_Reopened</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Should_Set_Picked_Up_Time_True</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Picked_Up_Date__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.Status</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>On Hold</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Picked_Up_Time</targetReference>
            </connector>
            <label>Should Set Picked Up Time True</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>ApproverResponseTime</name>
        <dataType>Number</dataType>
        <expression>({!$Flow.CurrentDateTime}- {!$Record__Prior.ClosedDate})*24*60</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>QueueDeveloperName</name>
        <dataType>String</dataType>
        <expression>CASE({!$Record.Priority},
  &quot;Medium - Returns&quot;, &quot;On_Hold_Returns&quot;,
  &quot;High - Orders&quot;, &quot;On_Hold_Orders&quot;,
  &quot;Samples&quot;, &quot;On_Hold_Samples&quot;,
  &quot;Corp-Orders&quot;, &quot;On_Hold_Corp_Orders&quot;,
  &quot;eCommerce&quot;, &quot;On_Hold_eCommerce&quot;,
  &quot;COA&quot;, &quot;On_Hold_COA&quot;,
  &quot;Complaints&quot;, &quot;On_Hold_Complaints&quot;,
  &quot;AP&quot;, &quot;On_Hold_AP&quot;,
  &quot;AR&quot;, &quot;On_Hold_AR&quot;,
 &quot;CustomerMaster&quot;, &quot;On_Hold_CustomerMaster&quot;,
 &quot;Logistics&quot;, &quot;On_Hold_Logistics&quot;,
 &quot;Procurement&quot;, &quot;On_Hold_Procurement&quot;,
 &quot;Info&quot;, &quot;On_Hold_Info&quot;,
&quot;IT Support&quot;, &quot;On_Hold_IT_Support&quot;,
 &quot;Info EU&quot;, &quot;On_Hold_Info_EU&quot;,
 &quot;Orders EMEA&quot;, &quot;On_Hold_Orders_EMEA&quot;,
 &quot;APAC Orders&quot;, &quot;On_Hold_APAC_Orders&quot;,
 &quot;AP Canada&quot;, &quot;On_Hold_AP_Canada&quot;,
&quot;Service Clients&quot;, &quot;On_Hold_Service_Clients&quot;,
&quot;Samples&quot;)</expression>
    </formulas>
    <formulas>
        <name>Re_openings_increased</name>
        <dataType>Number</dataType>
        <expression>{!$Record.Number_of_re_openings__c} + 1</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>TotalOnHoldTime</name>
        <dataType>Number</dataType>
        <expression>IF(NOT(ISBLANK({!$Record.Total_On_Hold_Time__c})), {!$Record.Total_On_Hold_Time__c} + (({!$Record.On_Hold_End__c} - {!$Record.On_Hold_Date__c}) *24 *60), ({!$Record.On_Hold_End__c} - {!$Record.On_Hold_Date__c}) *24 *60)</expression>
        <scale>2</scale>
    </formulas>
