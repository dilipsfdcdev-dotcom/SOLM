<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <description>Searches cases by keyword, status, priority, or date range. Used by Agentforce IT Helpdesk Agent for filtered case lookup.</description>
    <label>SolM Search Cases</label>
    <processType>AutoLaunchedFlow</processType>
    <status>Active</status>

    <variables>
        <name>contactId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>keyword</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>statusFilter</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>priorityFilter</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>dateFrom</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>dateTo</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>caseList</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
        <objectType>Case</objectType>
    </variables>
    <variables>
        <name>resultCount</name>
        <dataType>Number</dataType>
        <scale>0</scale>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>soqlQuery</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>

    <start>
        <locationX>50</locationX>
        <locationY>50</locationY>
        <connector>
            <targetReference>Build_Base_Filter</targetReference>
        </connector>
    </start>

    <!-- NOTE: Salesforce Flow does not support fully dynamic SOQL with runtime WHERE clauses.
         Instead, use a Decision tree to branch into pre-built RecordLookup elements
         based on which filters are provided. Below covers the most common combinations. -->

    <!-- DECISION: Which filters are active? -->
    <decisions>
        <name>Build_Base_Filter</name>
        <label>Determine Filter Combination</label>
        <locationX>200</locationX>
        <locationY>150</locationY>
        <defaultConnectorLabel>Contact Only</defaultConnectorLabel>
        <defaultConnector>
            <targetReference>Search_Contact_Only</targetReference>
        </defaultConnector>
        <rules>
            <name>Has_Status_And_Priority</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>statusFilter</leftValueReference>
                <operator>IsNull</operator>
                <rightValue><booleanValue>false</booleanValue></rightValue>
            </conditions>
            <conditions>
                <leftValueReference>priorityFilter</leftValueReference>
                <operator>IsNull</operator>
                <rightValue><booleanValue>false</booleanValue></rightValue>
            </conditions>
            <connector><targetReference>Search_Status_And_Priority</targetReference></connector>
            <label>Status AND Priority Provided</label>
        </rules>
        <rules>
            <name>Has_Status_Only</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>statusFilter</leftValueReference>
                <operator>IsNull</operator>
                <rightValue><booleanValue>false</booleanValue></rightValue>
            </conditions>
            <connector><targetReference>Search_Status_Only</targetReference></connector>
            <label>Status Only</label>
        </rules>
        <rules>
            <name>Has_Priority_Only</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>priorityFilter</leftValueReference>
                <operator>IsNull</operator>
                <rightValue><booleanValue>false</booleanValue></rightValue>
            </conditions>
            <connector><targetReference>Search_Priority_Only</targetReference></connector>
            <label>Priority Only</label>
        </rules>
    </decisions>

    <!-- RECORD LOOKUP: Contact Only (all cases) -->
    <recordLookups>
        <name>Search_Contact_Only</name>
        <label>Search - All Cases for Contact</label>
        <locationX>50</locationX>
        <locationY>350</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector><targetReference>Set_Result_Count</targetReference></connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>ContactId</field>
            <operator>EqualTo</operator>
            <value><elementReference>contactId</elementReference></value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Case</object>
        <outputReference>caseList</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>CaseNumber</queriedFields>
        <queriedFields>Subject</queriedFields>
        <queriedFields>Status</queriedFields>
        <queriedFields>Priority</queriedFields>
        <queriedFields>Type</queriedFields>
        <queriedFields>Description</queriedFields>
        <queriedFields>CreatedDate</queriedFields>
        <queriedFields>LastModifiedDate</queriedFields>
        <sortField>LastModifiedDate</sortField>
        <sortOrder>Desc</sortOrder>
        <limit>50</limit>
    </recordLookups>

    <!-- RECORD LOOKUP: Status AND Priority -->
    <recordLookups>
        <name>Search_Status_And_Priority</name>
        <label>Search - Status and Priority</label>
        <locationX>250</locationX>
        <locationY>350</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector><targetReference>Set_Result_Count</targetReference></connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>ContactId</field>
            <operator>EqualTo</operator>
            <value><elementReference>contactId</elementReference></value>
        </filters>
        <filters>
            <field>Status</field>
            <operator>EqualTo</operator>
            <value><elementReference>statusFilter</elementReference></value>
        </filters>
        <filters>
            <field>Priority</field>
            <operator>EqualTo</operator>
            <value><elementReference>priorityFilter</elementReference></value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Case</object>
        <outputReference>caseList</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>CaseNumber</queriedFields>
        <queriedFields>Subject</queriedFields>
        <queriedFields>Status</queriedFields>
        <queriedFields>Priority</queriedFields>
        <queriedFields>Type</queriedFields>
        <queriedFields>CreatedDate</queriedFields>
        <sortField>LastModifiedDate</sortField>
        <sortOrder>Desc</sortOrder>
        <limit>50</limit>
    </recordLookups>

    <!-- RECORD LOOKUP: Status Only -->
    <recordLookups>
        <name>Search_Status_Only</name>
        <label>Search - Status Only</label>
        <locationX>450</locationX>
        <locationY>350</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector><targetReference>Set_Result_Count</targetReference></connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>ContactId</field>
            <operator>EqualTo</operator>
            <value><elementReference>contactId</elementReference></value>
        </filters>
        <filters>
            <field>Status</field>
            <operator>EqualTo</operator>
            <value><elementReference>statusFilter</elementReference></value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Case</object>
        <outputReference>caseList</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>CaseNumber</queriedFields>
        <queriedFields>Subject</queriedFields>
        <queriedFields>Status</queriedFields>
        <queriedFields>Priority</queriedFields>
        <queriedFields>Type</queriedFields>
        <queriedFields>CreatedDate</queriedFields>
        <sortField>LastModifiedDate</sortField>
        <sortOrder>Desc</sortOrder>
        <limit>50</limit>
    </recordLookups>

    <!-- RECORD LOOKUP: Priority Only -->
    <recordLookups>
        <name>Search_Priority_Only</name>
        <label>Search - Priority Only</label>
        <locationX>650</locationX>
        <locationY>350</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector><targetReference>Set_Result_Count</targetReference></connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>ContactId</field>
            <operator>EqualTo</operator>
            <value><elementReference>contactId</elementReference></value>
        </filters>
        <filters>
            <field>Priority</field>
            <operator>EqualTo</operator>
            <value><elementReference>priorityFilter</elementReference></value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Case</object>
        <outputReference>caseList</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>CaseNumber</queriedFields>
        <queriedFields>Subject</queriedFields>
        <queriedFields>Status</queriedFields>
        <queriedFields>Priority</queriedFields>
        <queriedFields>Type</queriedFields>
        <queriedFields>CreatedDate</queriedFields>
        <sortField>LastModifiedDate</sortField>
        <sortOrder>Desc</sortOrder>
        <limit>50</limit>
    </recordLookups>

    <assignments>
        <name>Set_Result_Count</name>
        <label>Set Result Count</label>
        <locationX>400</locationX>
        <locationY>550</locationY>
        <assignmentItems>
            <assignToReference>resultCount</assignToReference>
            <operator>AssignCount</operator>
            <value><elementReference>caseList</elementReference></value>
        </assignmentItems>
    </assignments>
</Flow>
