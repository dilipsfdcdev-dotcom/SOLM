<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <description>Returns aggregated case counts by status and priority for reporting. Used by Agentforce IT Helpdesk Agent.</description>
    <label>SolM Get Case Summary</label>
    <processType>AutoLaunchedFlow</processType>
    <status>Active</status>

    <variables>
        <n>contactId</n>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>

    <!-- Output counts per status -->
    <variables>
        <n>countNew</n>
        <dataType>Number</dataType>
        <scale>0</scale>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
        <value><numberValue>0</numberValue></value>
    </variables>
    <variables>
        <n>countOpen</n>
        <dataType>Number</dataType>
        <scale>0</scale>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
        <value><numberValue>0</numberValue></value>
    </variables>
    <variables>
        <n>countInProgress</n>
        <dataType>Number</dataType>
        <scale>0</scale>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
        <value><numberValue>0</numberValue></value>
    </variables>
    <variables>
        <n>countWaiting</n>
        <dataType>Number</dataType>
        <scale>0</scale>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
        <value><numberValue>0</numberValue></value>
    </variables>
    <variables>
        <n>countEscalated</n>
        <dataType>Number</dataType>
        <scale>0</scale>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
        <value><numberValue>0</numberValue></value>
    </variables>
    <variables>
        <n>countClosed</n>
        <dataType>Number</dataType>
        <scale>0</scale>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
        <value><numberValue>0</numberValue></value>
    </variables>
    <!-- Priority counts -->
    <variables>
        <n>countCritical</n>
        <dataType>Number</dataType>
        <scale>0</scale>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
        <value><numberValue>0</numberValue></value>
    </variables>
    <variables>
        <n>countHigh</n>
        <dataType>Number</dataType>
        <scale>0</scale>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
        <value><numberValue>0</numberValue></value>
    </variables>
    <variables>
        <n>countMedium</n>
        <dataType>Number</dataType>
        <scale>0</scale>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
        <value><numberValue>0</numberValue></value>
    </variables>
    <variables>
        <n>countLow</n>
        <dataType>Number</dataType>
        <scale>0</scale>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
        <value><numberValue>0</numberValue></value>
    </variables>
    <variables>
        <n>totalOpen</n>
        <dataType>Number</dataType>
        <scale>0</scale>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
        <value><numberValue>0</numberValue></value>
    </variables>

    <!-- Collections for each status bucket -->
    <variables>
        <n>newCases</n>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Case</objectType>
    </variables>
    <variables>
        <n>openCases</n>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Case</objectType>
    </variables>
    <variables>
        <n>inProgressCases</n>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Case</objectType>
    </variables>
    <variables>
        <n>waitingCases</n>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Case</objectType>
    </variables>
    <variables>
        <n>escalatedCases</n>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Case</objectType>
    </variables>
    <variables>
        <n>closedCases</n>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Case</objectType>
    </variables>

    <start>
        <locationX>50</locationX>
        <locationY>50</locationY>
        <connector><targetReference>Get_New_Cases</targetReference></connector>
    </start>

    <recordLookups>
        <n>Get_New_Cases</n>
        <label>Get New Cases</label>
        <locationX>200</locationX><locationY>150</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector><targetReference>Get_Open_Cases</targetReference></connector>
        <filterLogic>and</filterLogic>
        <filters><field>ContactId</field><operator>EqualTo</operator><value><elementReference>contactId</elementReference></value></filters>
        <filters><field>Status</field><operator>EqualTo</operator><value><stringValue>New</stringValue></value></filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Case</object>
        <outputReference>newCases</outputReference>
        <queriedFields>Id</queriedFields>
    </recordLookups>

    <recordLookups>
        <n>Get_Open_Cases</n>
        <label>Get Open Cases</label>
        <locationX>400</locationX><locationY>150</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector><targetReference>Get_InProgress_Cases</targetReference></connector>
        <filterLogic>and</filterLogic>
        <filters><field>ContactId</field><operator>EqualTo</operator><value><elementReference>contactId</elementReference></value></filters>
        <filters><field>Status</field><operator>EqualTo</operator><value><stringValue>Open</stringValue></value></filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Case</object>
        <outputReference>openCases</outputReference>
        <queriedFields>Id</queriedFields>
    </recordLookups>

    <recordLookups>
        <n>Get_InProgress_Cases</n>
        <label>Get In Progress Cases</label>
        <locationX>600</locationX><locationY>150</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector><targetReference>Get_Waiting_Cases</targetReference></connector>
        <filterLogic>and</filterLogic>
        <filters><field>ContactId</field><operator>EqualTo</operator><value><elementReference>contactId</elementReference></value></filters>
        <filters><field>Status</field><operator>EqualTo</operator><value><stringValue>In Progress</stringValue></value></filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Case</object>
        <outputReference>inProgressCases</outputReference>
        <queriedFields>Id</queriedFields>
    </recordLookups>

    <recordLookups>
        <n>Get_Waiting_Cases</n>
        <label>Get Waiting on Customer Cases</label>
        <locationX>800</locationX><locationY>150</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector><targetReference>Get_Escalated_Cases</targetReference></connector>
        <filterLogic>and</filterLogic>
        <filters><field>ContactId</field><operator>EqualTo</operator><value><elementReference>contactId</elementReference></value></filters>
        <filters><field>Status</field><operator>EqualTo</operator><value><stringValue>Waiting on Customer</stringValue></value></filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Case</object>
        <outputReference>waitingCases</outputReference>
        <queriedFields>Id</queriedFields>
    </recordLookups>

    <recordLookups>
        <n>Get_Escalated_Cases</n>
        <label>Get Escalated Cases</label>
        <locationX>1000</locationX><locationY>150</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector><targetReference>Get_Closed_Cases</targetReference></connector>
        <filterLogic>and</filterLogic>
        <filters><field>ContactId</field><operator>EqualTo</operator><value><elementReference>contactId</elementReference></value></filters>
        <filters><field>Status</field><operator>EqualTo</operator><value><stringValue>Escalated</stringValue></value></filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Case</object>
        <outputReference>escalatedCases</outputReference>
        <queriedFields>Id</queriedFields>
    </recordLookups>

    <recordLookups>
        <n>Get_Closed_Cases</n>
        <label>Get Closed Cases</label>
        <locationX>1200</locationX><locationY>150</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector><targetReference>Assign_All_Counts</targetReference></connector>
        <filterLogic>and</filterLogic>
        <filters><field>ContactId</field><operator>EqualTo</operator><value><elementReference>contactId</elementReference></value></filters>
        <filters><field>Status</field><operator>EqualTo</operator><value><stringValue>Closed</stringValue></value></filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Case</object>
        <outputReference>closedCases</outputReference>
        <queriedFields>Id</queriedFields>
    </recordLookups>

    <assignments>
        <n>Assign_All_Counts</n>
        <label>Assign All Counts</label>
        <locationX>1400</locationX><locationY>150</locationY>
        <assignmentItems>
            <assignToReference>countNew</assignToReference>
            <operator>AssignCount</operator>
            <value><elementReference>newCases</elementReference></value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>countOpen</assignToReference>
            <operator>AssignCount</operator>
            <value><elementReference>openCases</elementReference></value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>countInProgress</assignToReference>
            <operator>AssignCount</operator>
            <value><elementReference>inProgressCases</elementReference></value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>countWaiting</assignToReference>
            <operator>AssignCount</operator>
            <value><elementReference>waitingCases</elementReference></value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>countEscalated</assignToReference>
            <operator>AssignCount</operator>
            <value><elementReference>escalatedCases</elementReference></value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>countClosed</assignToReference>
            <operator>AssignCount</operator>
            <value><elementReference>closedCases</elementReference></value>
        </assignmentItems>
    </assignments>
</Flow>
