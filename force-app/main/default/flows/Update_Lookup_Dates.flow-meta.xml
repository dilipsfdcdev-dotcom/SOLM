    <description>Sets all Lookup Tables to today&apos;s date.</description>
    <environments>Default</environments>
    <formulas>
        <name>TodayDate</name>
        <dataType>String</dataType>
        <expression>TEXT(YEAR(TODAY())) &amp; &quot;-&quot; &amp; 
RIGHT(&quot;0&quot; &amp; TEXT(MONTH(TODAY())), 2) &amp; &quot;-&quot; &amp; 
RIGHT(&quot;0&quot; &amp; TEXT(DAY(TODAY())), 2) 
&amp; &quot; 00:00:00&quot;</expression>
    </formulas>
    <interviewLabel>Update Lookup Dates {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Update Lookup Dates</label>
