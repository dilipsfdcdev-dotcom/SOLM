config:
    agent_name: "IT_Helpdesk_Agent"
    agent_label: "IT Helpdesk Agent"
    description: "SolM IT Helpdesk Service Agent — end-to-end case management including creation, tracking, updates, closure, search, related case intelligence, reporting, reassignment, case history, and escalation."
    default_agent_user: "it_helpdesk_agent@00d8c000004f32b1937196699.ext"

system:
    messages:
        welcome: "Hi there! Welcome to SolM IT Helpdesk. I can help you create, track, update, and manage your support cases. What can I help you with today?"
        error: "I'm sorry, something went wrong on my end. Please try again, or type 'escalate' to connect with a live agent."
    instructions: "You are SolM IT Helpdesk Service Agent — a professional, helpful, and concise assistant providing comprehensive end-to-end case management for internal employees and external customers. Format case details in clean, readable structures. Always confirm destructive actions like closing or reassigning a case before proceeding. When collecting information for case creation or closure, ask ONE field at a time. Use the authenticated user's contact information automatically via the ContactId session variable. Never fabricate case numbers, statuses, or details. When displaying cases, use formatted tables or lists with Case Number, Subject, Status, Priority, and relevant dates."

variables:
    EndUserId: linked string
        source: @MessagingSession.MessagingEndUserId
        description: "This variable may also be referred to as MessagingEndUser Id"
    RoutableId: linked string
        source: @MessagingSession.Id
        description: "This variable may also be referred to as MessagingSession Id"
    ContactId: linked string
        source: @MessagingEndUser.ContactId
        description: "This variable may also be referred to as MessagingEndUser ContactId"
    EndUserLanguage: linked string
        source: @MessagingSession.EndUserLanguage
        description: "This variable may also be referred to as MessagingSession EndUserLanguage"

language:
    default_locale: "en_US"
    additional_locales: "en_AU,fr,de,it,es_MX,ja,zh_TW,zh_CN"

knowledge:
    citations_enabled: False

# ═══════════════════════════════════════════════════════
#  Entry Point
# ═══════════════════════════════════════════════════════

start_agent topic_selector:
    description: "Welcome the user and route to the appropriate topic based on their intent"

    reasoning:
        instructions: |
            Analyze the user's message and conversation history to route to the correct topic.
            Routing rules:
            - Case status, details, lookup, filtering, overdue, or find a case → go_to_case_inquiry_search
            - Create, log, open, raise, or submit a new case or ticket → go_to_case_creation
            - Update, edit, change status/priority, or add comments to a case → go_to_case_updates
            - Close, resolve, or mark a case as done → go_to_case_closure
            - Reassign, transfer ownership, or change case owner → go_to_case_reassignment
            - Case history, audit trail, changes, or activity log → go_to_case_history
            - Similar cases, related issues, known solutions, patterns → go_to_related_case_intelligence
            - Summaries, reports, daily workload, case counts, statistics → go_to_reporting_summaries
            - Speak to a human, live agent, or escalate → go_to_escalation
            - Vague, unclear, or general greeting → go_to_ambiguous_question
            If the user provides a case number directly, route to go_to_case_inquiry_search.
            If the user just says hi or a greeting, respond with the welcome message.

        actions:
            go_to_case_inquiry_search:
                action: "@utils.transition"
                target: "@topic.case_inquiry_search"
                description: "Route to case inquiry and search topic"
            go_to_case_creation:
                action: "@utils.transition"
                target: "@topic.case_creation"
                description: "Route to case creation topic"
            go_to_case_updates:
                action: "@utils.transition"
                target: "@topic.case_updates"
                description: "Route to case updates topic"
            go_to_case_closure:
                action: "@utils.transition"
                target: "@topic.case_closure"
                description: "Route to case closure topic"
            go_to_case_reassignment:
                action: "@utils.transition"
                target: "@topic.case_reassignment"
                description: "Route to case reassignment topic"
            go_to_case_history:
                action: "@utils.transition"
                target: "@topic.case_history"
                description: "Route to case history topic"
            go_to_related_case_intelligence:
                action: "@utils.transition"
                target: "@topic.related_case_intelligence"
                description: "Route to related case intelligence topic"
            go_to_reporting_summaries:
                action: "@utils.transition"
                target: "@topic.reporting_summaries"
                description: "Route to reporting and summaries topic"
            go_to_escalation:
                action: "@utils.transition"
                target: "@topic.escalation"
                description: "Route to escalation to live agent"
            go_to_ambiguous_question:
                action: "@utils.transition"
                target: "@topic.ambiguous_question"
                description: "Route to ambiguous question handling"


# ═══════════════════════════════════════════════════════
#  Topic: Case Inquiry & Search
# ═══════════════════════════════════════════════════════

topic case_inquiry_search:
    description: "Retrieve and display user's cases, show detailed case information, search and filter cases by various criteria, identify overdue cases, and provide case summaries."

    reasoning:
        instructions: |
            Help the user find and view their cases.
            1. RETRIEVE A SPECIFIC CASE:
               - Ask for case number if not provided.
               - Use ITHelpdesk_GetCase with contactId (from ContactId variable) and caseNumber.
               - Display: Subject, Status, Priority, Type, Created Date, Last Modified, Owner, Description.
            2. LIST ALL USER'S CASES:
               - Use ITHelpdesk_GetCasesByContact with the session ContactId.
               - Show totals: X Open, Y Closed.
               - List cases with Case Number, Subject, Status, Priority, Created Date.
            3. SEARCH AND FILTER:
               - Use ITHelpdesk_SearchCases with keywords, status filter (New, Open, In Progress, Escalated, Waiting on Customer, Closed), priority filter (Critical, High, Medium, Low), or date range.
            4. FIND OVERDUE CASES:
               - Use ITHelpdesk_GetOverdueCases to find cases open longer than the specified number of days (default 7).
            5. QUICK SUMMARY:
               - When user says "my cases" or "case summary", use ITHelpdesk_GetCasesByContact and show count by status with the 5 most recent open cases.
            If no cases found, say so clearly and offer to create a new one.

        actions:
            ITHelpdesk_GetCase:
                action: "@apex.ITHelpdesk_GetCase"
                description: "Get a specific case by case number"
            ITHelpdesk_GetCasesByContact:
                action: "@apex.ITHelpdesk_GetCasesByContact"
                description: "Get all cases for the authenticated user"
            ITHelpdesk_SearchCases:
                action: "@apex.ITHelpdesk_SearchCases"
                description: "Search and filter cases"
            ITHelpdesk_GetOverdueCases:
                action: "@apex.ITHelpdesk_GetOverdueCases"
                description: "Find overdue cases"

    actions:
        ITHelpdesk_GetCase:
            description: "Returns a case matching the given case number for the contact."
            label: "Get Case By Case Number"
            require_user_confirmation: False
            include_in_progress_indicator: True
            source: "ITHelpdesk_GetCase"
            target: "apex://ITHelpdesk_GetCase"
            inputs:
                contactId:
                    label: "Contact Id"
                    description: "The ContactId of the authenticated user."
                    source: "@variables.ContactId"
                    visibility: hidden
                caseNumber:
                    label: "Case Number"
                    description: "The case number provided by the customer."
                    visibility: visible
            outputs:
                caseRecord:
                    label: "Case Record"
                    description: "The case record found."
                    visibility: visible
                isFound:
                    label: "Is Found"
                    description: "Whether a matching case was found."
                    visibility: hidden
                message:
                    label: "Message"
                    description: "Result message."
                    visibility: visible

        ITHelpdesk_GetCasesByContact:
            description: "Returns all cases linked to the authenticated user's contact."
            label: "Get Cases By Contact"
            require_user_confirmation: False
            include_in_progress_indicator: True
            source: "ITHelpdesk_GetCasesByContact"
            target: "apex://ITHelpdesk_GetCasesByContact"
            inputs:
                contactId:
                    label: "Contact Id"
                    description: "The ContactId of the authenticated user."
                    source: "@variables.ContactId"
                    visibility: hidden
            outputs:
                caseList:
                    label: "Case List"
                    description: "List of case records."
                    visibility: visible
                totalCount:
                    label: "Total Count"
                    description: "Total number of cases."
                    visibility: visible
                openCount:
                    label: "Open Count"
                    description: "Number of open cases."
                    visibility: visible
                closedCount:
                    label: "Closed Count"
                    description: "Number of closed cases."
                    visibility: visible
                message:
                    label: "Message"
                    description: "Summary message."
                    visibility: visible

        ITHelpdesk_SearchCases:
            description: "Search cases by keyword, status, priority, or date range."
            label: "Search Cases"
            require_user_confirmation: False
            include_in_progress_indicator: True
            source: "ITHelpdesk_SearchCases"
            target: "apex://ITHelpdesk_SearchCases"
            inputs:
                contactId:
                    label: "Contact Id"
                    description: "ContactId of the user."
                    source: "@variables.ContactId"
                    visibility: hidden
                keyword:
                    label: "Keyword"
                    description: "Search keyword for subject or description."
                    visibility: visible
                statusFilter:
                    label: "Status Filter"
                    description: "Filter by status: New, Open, In Progress, Escalated, Waiting on Customer, Closed."
                    visibility: visible
                priorityFilter:
                    label: "Priority Filter"
                    description: "Filter by priority: Critical, High, Medium, Low."
                    visibility: visible
                dateFrom:
                    label: "Date From"
                    description: "Start date (YYYY-MM-DD)."
                    visibility: visible
                dateTo:
                    label: "Date To"
                    description: "End date (YYYY-MM-DD)."
                    visibility: visible
            outputs:
                caseList:
                    label: "Case List"
                    description: "Filtered list of case records."
                    visibility: visible
                resultCount:
                    label: "Result Count"
                    description: "Number of results."
                    visibility: visible
                message:
                    label: "Message"
                    description: "Result message."
                    visibility: visible

        ITHelpdesk_GetOverdueCases:
            description: "Returns cases open longer than a specified number of days."
            label: "Get Overdue Cases"
            require_user_confirmation: False
            include_in_progress_indicator: True
            source: "ITHelpdesk_GetOverdueCases"
            target: "apex://ITHelpdesk_GetOverdueCases"
            inputs:
                contactId:
                    label: "Contact Id"
                    description: "ContactId of the user."
                    source: "@variables.ContactId"
                    visibility: hidden
                daysOpen:
                    label: "Days Open"
                    description: "Number of days a case must be open to be considered overdue. Default is 7."
                    visibility: visible
            outputs:
                overdueCaseList:
                    label: "Overdue Case List"
                    description: "List of overdue case records."
                    visibility: visible
                overdueCount:
                    label: "Overdue Count"
                    description: "Number of overdue cases."
                    visibility: visible
                message:
                    label: "Message"
                    description: "Result message."
                    visibility: visible


# ═══════════════════════════════════════════════════════
#  Topic: Case Creation
# ═══════════════════════════════════════════════════════

topic case_creation:
    description: "Guide users step-by-step to create a new support case, validate inputs, auto-populate known details, confirm before submission, and assign to Support queue."

    reasoning:
        instructions: |
            Guide the user through creating a new case. Collect information ONE FIELD AT A TIME.
            Step 1 - Subject: Ask "What's the subject or brief title for your issue?" Validate not empty.
            Step 2 - Description: Ask "Please describe the issue in detail." Validate at least 10 characters.
            Step 3 - Priority: Ask "What priority level?" Offer: Critical, High, Medium (default), Low.
            Step 4 - Type: Ask "What type of issue?" Offer: Hardware, Software, Network, Access/Permissions, Email, Other.
            Auto-populate: ContactId from session variable, Origin as "Messaging", Status as "New".
            The case will be automatically assigned to the Support queue.
            Step 5 - Show full summary and ask "Shall I create this case? (Yes/No)"
            Step 6 - If confirmed, call ITHelpdesk_CreateCase.
            Respond with: "Case [CaseNumber] has been created successfully and assigned to the Support queue!"
            Never call CreateCase without user confirmation. If user cancels, transition back to topic_selector.

        actions:
            ITHelpdesk_CreateCase:
                action: "@apex.ITHelpdesk_CreateCase"
                description: "Create a new case"

    actions:
        ITHelpdesk_CreateCase:
            description: "Creates a new support case and assigns it to the Support queue."
            label: "Create Case"
            require_user_confirmation: True
            include_in_progress_indicator: True
            source: "ITHelpdesk_CreateCase"
            target: "apex://ITHelpdesk_CreateCase"
            inputs:
                contactId:
                    label: "Contact Id"
                    description: "ContactId of the authenticated user."
                    source: "@variables.ContactId"
                    visibility: hidden
                subject:
                    label: "Subject"
                    description: "Brief title or subject of the case."
                    visibility: visible
                description:
                    label: "Description"
                    description: "Detailed description of the issue."
                    visibility: visible
                priority:
                    label: "Priority"
                    description: "Case priority: Critical, High, Medium, Low. Default is Medium."
                    visibility: visible
                caseType:
                    label: "Type"
                    description: "Case type: Hardware, Software, Network, Access/Permissions, Email, Other."
                    visibility: visible
                origin:
                    label: "Origin"
                    description: "Origin of the case. Auto-set to Messaging."
                    visibility: hidden
            outputs:
                caseRecord:
                    label: "Case Record"
                    description: "The newly created case record."
                    visibility: visible
                caseNumber:
                    label: "Case Number"
                    description: "The generated case number."
                    visibility: visible
                caseId:
                    label: "Case Id"
                    description: "The Salesforce Id of the new case."
                    visibility: hidden
                isSuccess:
                    label: "Is Success"
                    description: "Whether the case was created successfully."
                    visibility: hidden
                message:
                    label: "Message"
                    description: "Result message."
                    visibility: visible


# ═══════════════════════════════════════════════════════
#  Topic: Case Updates
# ═══════════════════════════════════════════════════════

topic case_updates:
    description: "Allow users to update case details (status, priority, subject, description, type) and add comments to existing cases."

    reasoning:
        instructions: |
            Help users update their cases or add comments.
            FOR UPDATES:
            - Ask for case number if not provided.
            - Use ITHelpdesk_GetCase to retrieve current details and display them.
            - Ask what the user wants to update: status, priority, subject, description, or type.
            - Collect the new value.
            - Show the proposed change and confirm with user.
            - Call ITHelpdesk_UpdateCase.
            Valid status values: New, Open, In Progress, Escalated, Waiting on Customer.
            Valid priority values: Critical, High, Medium, Low.
            Valid type values: Hardware, Software, Network, Access/Permissions, Email, Other.
            FOR ADDING COMMENTS:
            - Ask for case number and comment text.
            - Confirm, then call ITHelpdesk_AddComment.
            ALWAYS confirm before applying any change.

        actions:
            ITHelpdesk_GetCase:
                action: "@apex.ITHelpdesk_GetCase"
                description: "Get case details before updating"
            ITHelpdesk_UpdateCase:
                action: "@apex.ITHelpdesk_UpdateCase"
                description: "Update case fields"
            ITHelpdesk_AddComment:
                action: "@apex.ITHelpdesk_AddComment"
                description: "Add a comment to a case"

    actions:
        ITHelpdesk_GetCase:
            description: "Returns a case matching the given case number for the contact."
            label: "Get Case By Case Number"
            require_user_confirmation: False
            include_in_progress_indicator: True
            source: "ITHelpdesk_GetCase"
            target: "apex://ITHelpdesk_GetCase"
            inputs:
                contactId:
                    label: "Contact Id"
                    description: "The ContactId of the authenticated user."
                    source: "@variables.ContactId"
                    visibility: hidden
                caseNumber:
                    label: "Case Number"
                    description: "The case number."
                    visibility: visible
            outputs:
                caseRecord:
                    label: "Case Record"
                    description: "The case record."
                    visibility: visible
                isFound:
                    label: "Is Found"
                    description: "Whether found."
                    visibility: hidden
                message:
                    label: "Message"
                    description: "Result message."
                    visibility: visible

        ITHelpdesk_UpdateCase:
            description: "Updates one or more fields on an existing case."
            label: "Update Case"
            require_user_confirmation: True
            include_in_progress_indicator: True
            source: "ITHelpdesk_UpdateCase"
            target: "apex://ITHelpdesk_UpdateCase"
            inputs:
                caseId:
                    label: "Case Id"
                    description: "Salesforce record Id of the case."
                    visibility: hidden
                status:
                    label: "Status"
                    description: "New status: New, Open, In Progress, Escalated, Waiting on Customer."
                    visibility: visible
                priority:
                    label: "Priority"
                    description: "New priority: Critical, High, Medium, Low."
                    visibility: visible
                description:
                    label: "Description"
                    description: "Updated description."
                    visibility: visible
                caseType:
                    label: "Type"
                    description: "Updated type."
                    visibility: visible
                subject:
                    label: "Subject"
                    description: "Updated subject."
                    visibility: visible
            outputs:
                caseRecord:
                    label: "Case Record"
                    description: "The updated case record."
                    visibility: visible
                isSuccess:
                    label: "Is Success"
                    description: "Whether the update succeeded."
                    visibility: hidden
                message:
                    label: "Message"
                    description: "Result message."
                    visibility: visible

        ITHelpdesk_AddComment:
            description: "Adds a comment to an existing case."
            label: "Add Case Comment"
            require_user_confirmation: True
            include_in_progress_indicator: True
            source: "ITHelpdesk_AddComment"
            target: "apex://ITHelpdesk_AddComment"
            inputs:
                caseId:
                    label: "Case Id"
                    description: "Salesforce record Id of the case."
                    visibility: hidden
                commentBody:
                    label: "Comment"
                    description: "The comment text."
                    visibility: visible
                isPublic:
                    label: "Is Public"
                    description: "Whether the comment is visible to the customer. Default is true."
                    visibility: hidden
            outputs:
                commentId:
                    label: "Comment Id"
                    description: "Id of the created comment."
                    visibility: hidden
                isSuccess:
                    label: "Is Success"
                    description: "Whether the comment was added."
                    visibility: hidden
                message:
                    label: "Message"
                    description: "Result message."
                    visibility: visible


# ═══════════════════════════════════════════════════════
#  Topic: Case Closure
# ═══════════════════════════════════════════════════════

topic case_closure:
    description: "Guide through the closure process with required resolution details and confirmation."

    reasoning:
        instructions: |
            Guide users through closing their cases.
            Step 1: Ask for case number if not provided.
            Step 2: Use ITHelpdesk_GetCase to retrieve and display current details.
            Step 3: Check status — cannot close an already-closed case.
            Step 4: Collect resolution summary (required). Ask: "How was this issue resolved?"
            Step 5: Collect root cause (optional). Ask: "What was the root cause? (or skip)"
            Step 6: Collect closure notes (optional). Ask: "Any additional notes? (or skip)"
            Step 7: Show full closure summary and ask:
                    "Are you sure you want to close this case? This cannot be easily undone. (Yes/No)"
            Step 8: If confirmed, call ITHelpdesk_CloseCase.
            ALWAYS confirm before closing. If user cancels, transition back to topic_selector.

        actions:
            ITHelpdesk_GetCase:
                action: "@apex.ITHelpdesk_GetCase"
                description: "Get case details before closing"
            ITHelpdesk_CloseCase:
                action: "@apex.ITHelpdesk_CloseCase"
                description: "Close a case"

    actions:
        ITHelpdesk_GetCase:
            description: "Returns a case matching the given case number for the contact."
            label: "Get Case By Case Number"
            require_user_confirmation: False
            include_in_progress_indicator: True
            source: "ITHelpdesk_GetCase"
            target: "apex://ITHelpdesk_GetCase"
            inputs:
                contactId:
                    label: "Contact Id"
                    description: "The ContactId of the authenticated user."
                    source: "@variables.ContactId"
                    visibility: hidden
                caseNumber:
                    label: "Case Number"
                    description: "The case number."
                    visibility: visible
            outputs:
                caseRecord:
                    label: "Case Record"
                    description: "The case record."
                    visibility: visible
                isFound:
                    label: "Is Found"
                    description: "Whether found."
                    visibility: hidden
                message:
                    label: "Message"
                    description: "Result message."
                    visibility: visible

        ITHelpdesk_CloseCase:
            description: "Closes a case with a resolution summary and optional root cause and notes."
            label: "Close Case"
            require_user_confirmation: True
            include_in_progress_indicator: True
            source: "ITHelpdesk_CloseCase"
            target: "apex://ITHelpdesk_CloseCase"
            inputs:
                caseId:
                    label: "Case Id"
                    description: "Salesforce record Id of the case to close."
                    visibility: hidden
                resolutionSummary:
                    label: "Resolution Summary"
                    description: "Summary of how the issue was resolved."
                    visibility: visible
                rootCause:
                    label: "Root Cause"
                    description: "Root cause of the issue."
                    visibility: visible
                closureNotes:
                    label: "Closure Notes"
                    description: "Additional closure notes."
                    visibility: visible
            outputs:
                caseRecord:
                    label: "Case Record"
                    description: "The closed case record."
                    visibility: visible
                isSuccess:
                    label: "Is Success"
                    description: "Whether the case was closed."
                    visibility: hidden
                message:
                    label: "Message"
                    description: "Result message."
                    visibility: visible


# ═══════════════════════════════════════════════════════
#  Topic: Case Reassignment
# ═══════════════════════════════════════════════════════

topic case_reassignment:
    description: "Reassign cases to different users or queues."

    reasoning:
        instructions: |
            Help users reassign their cases to a different owner or queue.
            Step 1: Ask for case number if not provided.
            Step 2: Use ITHelpdesk_GetCase to retrieve and display current details including current owner.
            Step 3: Ask where to reassign: a specific user or a queue.
            Step 4: If queue, ask for queue name. Common queues: Support, IT_Omega, Service_Clients, Complaints.
            Step 5: Show proposed reassignment and confirm with user.
            Step 6: Call ITHelpdesk_ReassignCase.
            ALWAYS confirm before reassigning.

        actions:
            ITHelpdesk_GetCase:
                action: "@apex.ITHelpdesk_GetCase"
                description: "Get case details before reassignment"
            ITHelpdesk_ReassignCase:
                action: "@apex.ITHelpdesk_ReassignCase"
                description: "Reassign a case"

    actions:
        ITHelpdesk_GetCase:
            description: "Returns a case matching the given case number for the contact."
            label: "Get Case By Case Number"
            require_user_confirmation: False
            include_in_progress_indicator: True
            source: "ITHelpdesk_GetCase"
            target: "apex://ITHelpdesk_GetCase"
            inputs:
                contactId:
                    label: "Contact Id"
                    description: "The ContactId of the authenticated user."
                    source: "@variables.ContactId"
                    visibility: hidden
                caseNumber:
                    label: "Case Number"
                    description: "The case number."
                    visibility: visible
            outputs:
                caseRecord:
                    label: "Case Record"
                    description: "The case record."
                    visibility: visible
                isFound:
                    label: "Is Found"
                    description: "Whether found."
                    visibility: hidden
                message:
                    label: "Message"
                    description: "Result message."
                    visibility: visible

        ITHelpdesk_ReassignCase:
            description: "Reassigns a case to a different user or queue."
            label: "Reassign Case"
            require_user_confirmation: True
            include_in_progress_indicator: True
            source: "ITHelpdesk_ReassignCase"
            target: "apex://ITHelpdesk_ReassignCase"
            inputs:
                caseId:
                    label: "Case Id"
                    description: "Salesforce record Id of the case."
                    visibility: hidden
                newOwnerId:
                    label: "New Owner Id"
                    description: "User Id or Queue Id to reassign to."
                    visibility: visible
                queueName:
                    label: "Queue Name"
                    description: "Queue developer name (e.g. Support, IT_Omega, Service_Clients)."
                    visibility: visible
            outputs:
                caseRecord:
                    label: "Case Record"
                    description: "The reassigned case record."
                    visibility: visible
                isSuccess:
                    label: "Is Success"
                    description: "Whether the reassignment succeeded."
                    visibility: hidden
                message:
                    label: "Message"
                    description: "Result message."
                    visibility: visible


# ═══════════════════════════════════════════════════════
#  Topic: Case History
# ═══════════════════════════════════════════════════════

topic case_history:
    description: "Retrieve and display case activity history including comments and field changes."

    reasoning:
        instructions: |
            Help users view the history and audit trail of a case.
            Step 1: Ask for case number if not provided.
            Step 2: Use ITHelpdesk_GetCase to verify the case exists.
            Step 3: Use ITHelpdesk_GetCaseHistory to retrieve comments and field changes.
            Step 4: Display:
                    - Recent comments with author, date, and content
                    - Field change history showing what changed, by whom, and when
            If no history exists, say "No activity history recorded for this case."

        actions:
            ITHelpdesk_GetCase:
                action: "@apex.ITHelpdesk_GetCase"
                description: "Get case details to verify"
            ITHelpdesk_GetCaseHistory:
                action: "@apex.ITHelpdesk_GetCaseHistory"
                description: "Get case history and comments"

    actions:
        ITHelpdesk_GetCase:
            description: "Returns a case matching the given case number for the contact."
            label: "Get Case By Case Number"
            require_user_confirmation: False
            include_in_progress_indicator: True
            source: "ITHelpdesk_GetCase"
            target: "apex://ITHelpdesk_GetCase"
            inputs:
                contactId:
                    label: "Contact Id"
                    description: "The ContactId of the authenticated user."
                    source: "@variables.ContactId"
                    visibility: hidden
                caseNumber:
                    label: "Case Number"
                    description: "The case number."
                    visibility: visible
            outputs:
                caseRecord:
                    label: "Case Record"
                    description: "The case record."
                    visibility: visible
                isFound:
                    label: "Is Found"
                    description: "Whether found."
                    visibility: hidden
                message:
                    label: "Message"
                    description: "Result message."
                    visibility: visible

        ITHelpdesk_GetCaseHistory:
            description: "Retrieves comments and field-change history for a case."
            label: "Get Case History"
            require_user_confirmation: False
            include_in_progress_indicator: True
            source: "ITHelpdesk_GetCaseHistory"
            target: "apex://ITHelpdesk_GetCaseHistory"
