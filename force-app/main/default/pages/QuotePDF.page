<apex:page standardController="Quote" extensions="QuotePdfExactController"
           renderAs="pdf" showHeader="false" applyBodyTag="false" standardStylesheets="false">
<html>
<head>
<meta charset="utf-8"/>
<style>
  @page {
    size: A4;
    margin: 15mm 18mm 15mm 18mm;
  }
  body {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 9.5pt;
    color: #333;
    margin: 0;
    padding: 0;
    line-height: 1.45;
  }
  table {
    border-collapse: collapse;
    width: 100%;
  }
  .section-title {
    font-size: 18pt;
    font-weight: 300;
    color: #222;
    padding-bottom: 8px;
    border-bottom: 1.5px solid #ccc;
    margin-top: 22px;
    margin-bottom: 14px;
  }
  .header-table td {
    vertical-align: top;
  }
  .info-label {
    font-size: 8.5pt;
    color: #666;
    padding: 2px 0;
  }
  .info-value {
    font-size: 9.5pt;
    color: #333;
    padding: 2px 0;
  }
  .data-table {
    width: 100%;
    border: 1px solid #ddd;
    margin-bottom: 6px;
  }
  .data-table th {
    background-color: #f2f2f2;
    -webkit-print-color-adjust: exact;
    color-adjust: exact;
    font-weight: 600;
    font-size: 8.5pt;
    color: #444;
    padding: 8px 10px;
    border: 1px solid #ddd;
    text-align: left;
  }
  .data-table td {
    padding: 8px 10px;
    border: 1px solid #ddd;
    font-size: 9.5pt;
    color: #333;
  }
  .total-row td {
    text-align: right;
    font-weight: 600;
    padding: 8px 10px;
    font-size: 9.5pt;
  }
  .conditions-table td {
    padding: 3px 0;
    font-size: 9.5pt;
    vertical-align: top;
  }
  .conditions-label {
    font-weight: 600;
    color: #444;
    width: 35%;
    padding-right: 12px;
  }
  .fine-print {
    font-size: 7.5pt;
    color: #777;
    line-height: 1.4;
    margin-top: 10px;
    text-align: justify;
  }
  .divider {
    border: none;
    border-top: 1px solid #ddd;
    margin: 18px 0;
  }
</style>
</head>
<body>

<!-- ============================================================ -->
<!-- HEADER: Logo left, company info center, offer details right   -->
<!-- ============================================================ -->
<table style="width:100%; margin-bottom:16px;" class="header-table">
  <tr>
    <td style="width:25%; vertical-align:middle;">
      <img src="{!URLFOR($Resource.SolMillenniumLogo)}" alt="Sol-Millennium Logo"
           style="width:180px; height:auto;"/>
    </td>
    <td style="width:40%; vertical-align:middle; padding-left:10px;">
      <div style="font-size:9pt; color:#555; line-height:1.5;">
        Sol-Millennium Europe Sp. z o.o.<br/>
        Ul. Twarda 18<br/>
        00-105 Warszawa<br/>
        Poland
      </div>
    </td>
    <td style="width:35%; vertical-align:middle; text-align:right;">
      <div style="font-size:9pt; color:#555; line-height:1.7; text-align:right;">
        <span style="font-weight:600; font-size:10pt; color:#333;">OFFER for {!IF(NOT(ISNULL(quoteRec.AccountId)), quoteRec.Account.Name, ' ')}</span><br/>
        Offer Created: {!todayFormatted}<br/>
        Offer Validity: {!offerValidityFormatted}
      </div>
    </td>
  </tr>
</table>

<!-- ============================================================ -->
<!-- DIVIDER below header                                          -->
<!-- ============================================================ -->
<hr class="divider" style="margin-top:4px;"/>

<!-- ============================================================ -->
<!-- 1. PARTIES (Address Information)                              -->
<!-- ============================================================ -->
<div class="section-title">1. Parties</div>

<table style="width:100%; margin-bottom:4px;">
  <tr>
    <td style="width:48%; vertical-align:top;">
      <div style="font-size:8.5pt; color:#888; text-transform:uppercase; letter-spacing:0.5px; margin-bottom:6px;">From:</div>
      <div style="font-size:9.5pt; line-height:1.6; color:#333;">
        <strong>Sol-Millennium Europe Sp. z o.o.</strong><br/>
        Ul. Twarda 18<br/>
        00-105 Warszawa<br/>
        Poland
      </div>
    </td>
    <td style="width:4%;"></td>
    <td style="width:48%; vertical-align:top;">
      <div style="font-size:8.5pt; color:#888; text-transform:uppercase; letter-spacing:0.5px; margin-bottom:6px;">To:</div>
      <div style="font-size:9.5pt; line-height:1.6; color:#333;">
        <strong>{!IF(NOT(ISNULL(quoteRec.AccountId)), quoteRec.Account.Name, ' ')}</strong><br/>
        {!IF(NOT(ISNULL(quoteRec.AccountId)), quoteRec.Account.BillingStreet, ' ')}<br/>
        {!IF(NOT(ISNULL(quoteRec.AccountId)), quoteRec.Account.BillingPostalCode + ' ' + quoteRec.Account.BillingCity, ' ')}<br/>
        {!IF(NOT(ISNULL(quoteRec.AccountId)), quoteRec.Account.BillingCountry, ' ')}
      </div>
    </td>
  </tr>
</table>

<div class="fine-print" style="margin-bottom:10px; font-style:italic;">
  The information in this offer is confidential and may be legally privileged. It is intended solely for the addressee.
</div>

<!-- ============================================================ -->
<!-- 2. CONTACT DETAILS                                            -->
<!-- ============================================================ -->
<hr class="divider"/>
<div class="section-title">2. Contact Details</div>

<table style="width:100%; margin-bottom:4px;">
  <tr>
    <td style="width:48%; vertical-align:top;">
      <div style="margin-bottom:8px;">
        <div class="info-label">Contact Name</div>
        <div class="info-value"><strong>{!IF(NOT(ISNULL(quoteRec.Contact.Name)), quoteRec.Contact.Name, ' ')}</strong></div>
      </div>
      <div style="margin-bottom:8px;">
        <div class="info-label">Mobile</div>
        <div class="info-value">{!IF(NOT(ISNULL(quoteRec.Phone)), quoteRec.Phone, ' ')}</div>
      </div>
      <div style="margin-bottom:8px;">
        <div class="info-label">Email</div>
        <div class="info-value">{!IF(NOT(ISNULL(quoteRec.Email)), quoteRec.Email, ' ')}</div>
      </div>
    </td>
    <td style="width:4%;"></td>
    <td style="width:48%; vertical-align:top;">
      <div style="margin-bottom:8px;">
        <div class="info-label">Order Processing</div>
        <div class="info-value">orders-EU@sol-m.com</div>
      </div>
      <div style="margin-bottom:8px;">
        <div class="info-label">Regulatory &amp; Complaints</div>
        <div class="info-value">complaints@sol-m.com</div>
      </div>
      <div style="margin-bottom:8px;">
        <div class="info-label">Payments &amp; Accounting</div>
        <div class="info-value">Office-EU@sol-m.com</div>
      </div>
    </td>
  </tr>
</table>

<!-- ============================================================ -->
<!-- 3. OFFER CONDITIONS (Terms and Conditions style)              -->
<!-- ============================================================ -->
<hr class="divider"/>
<div class="section-title">3. Offer Conditions</div>

<table style="width:100%; margin-bottom:10px;">
  <tr>
    <td style="width:48%; vertical-align:top;">
      <table class="conditions-table">
        <tr>
          <td class="conditions-label">Payment terms:</td>
          <td>14 days credit (Net14-C)</td>
        </tr>
        <tr>
          <td class="conditions-label">Offer currency:</td>
          <td>{!quoteRec.CurrencyIsoCode}</td>
        </tr>
        <tr>
          <td class="conditions-label">Shipment origin:</td>
          <td>Poland</td>
        </tr>
      </table>
    </td>
    <td style="width:4%;"></td>
    <td style="width:48%; vertical-align:top;">
      <table class="conditions-table">
        <tr>
          <td class="conditions-label">Incoterms 2024:</td>
          <td>{!quoteRec.Incoterm__c}</td>
        </tr>
        <tr>
          <td class="conditions-label">Comments:</td>
          <td>Full cases only</td>
        </tr>
      </table>
    </td>
  </tr>
</table>

<div class="fine-print" style="margin-bottom:6px;">
  Prices are exclusive of VAT and other applicable taxes. All costs and expenses, including bank charges, associated with the bank transfer will be solely borne by the Customer. Parties hereto agree to renegotiate the prices upon written notice in case Sol-Millennium is able to prove a significant increase of its own costs for the products, components or materials. This offer supersedes and replaces all previous agreements, whether written or oral, or correspondence between the Parties with respect to the subject matter of this Offer.
</div>

<!-- ============================================================ -->
<!-- 4. PRODUCTS (Services table style)                            -->
<!-- ============================================================ -->
<hr class="divider"/>
<div class="section-title">4. Products</div>

<table class="data-table">
  <thead>
    <tr>
      <th style="text-align:left;">REF</th>
      <th style="text-align:left;">Product description</th>
      <th style="text-align:center;">Qty box / case</th>
      <th style="text-align:right;">Price per pcs</th>
      <th style="text-align:right;">Price per box</th>
    </tr>
  </thead>
  <tbody>
    <apex:repeat value="{!lineItemWrappers}" var="li">
      <tr>
        <td>{!li.refVal}</td>
        <td>{!li.description}</td>
        <td style="text-align:center;">{!li.qty}</td>
        <td style="text-align:right; white-space:nowrap;">{!li.unitPrice}</td>
        <td style="text-align:right; white-space:nowrap;">{!li.totalPrice}</td>
      </tr>
    </apex:repeat>

    <apex:outputPanel rendered="{!IF(lineItemWrappers.size==0,true,false)}">
      <tr>
        <td>MSK003X</td>
        <td>IQ-M Procedure Mask - ASTM 1</td>
        <td style="text-align:center;">50 / 2000</td>
        <td style="text-align:right;">0.0250</td>
        <td style="text-align:right;">1.25</td>
      </tr>
    </apex:outputPanel>
  </tbody>
</table>

<!-- TOTAL row aligned right, matching Salesforce style -->
<table style="width:100%; margin-top:0px;">
  <tr>
    <td style="text-align:right; padding:8px 10px; font-size:9.5pt; font-weight:600; color:#333;">
      <!-- Total: {!totalPriceFormatted} -->
    </td>
  </tr>
</table>

</body>
</html>
</apex:page>