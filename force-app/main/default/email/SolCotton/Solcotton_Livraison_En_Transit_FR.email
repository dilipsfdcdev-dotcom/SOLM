<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.01 Transitional//EN" "http://www.w3.org/TR/html4/loose.dtd">
<html>
<head>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
  <style type="text/css">
    body {-webkit-text-size-adjust:100%; -ms-text-size-adjust:100%; margin:0 !important; padding:20px; background:#EFEFEF; font-family:Arial, Helvetica, sans-serif;}
    table td { border-collapse: collapse; }
    img {display:block; border:none; outline:none;}
    a img {border:none;}
    @media only screen and (max-width:480px){
      .container{width:100% !important;}
      img{max-width:100% !important; height:auto !important;}
      body{font-size:16px !important; line-height:150% !important; padding:0 !important;}
    }
  </style>
</head>

<body>
  <div style="font-size:0; line-height:0;">
    <custom name="opencounter" type="tracking"><custom name="usermatch" type="tracking" />
  </div>

  <table role="presentation" width="100%" border="0" cellspacing="0" cellpadding="0" align="center">
    <tr><td align="center">

      <table role="presentation" width="600" border="0" cellspacing="0" cellpadding="0" class="container" style="background:#FFFFFF;">

        <!-- LOGO -->
        <tr>
          <td align="center" style="padding:20px 10px 0;">
            <img src="https://solmillenium2.my.salesforce-sites.com/resource/SolcottonHeading0" width="180" alt="SolCotton" style="height:auto; margin:0 auto;">
          </td>
        </tr>

        <!-- HERO IMAGE -->
        <tr>
          <td align="center" style="padding:10px 20px 0;">
            <img src="https://solmillenium2.my.salesforce-sites.com/resource/SolcottonHeading1" width="560" alt="Votre commande est en transit" style="width:100%; max-width:560px; height:auto;">
          </td>
        </tr>

        <!-- MESSAGE -->
        <tr>
          <td style="padding:20px; text-align:center; font-size:14px; line-height:150%; color:#181818;">
            Bonjour {!Lead.FirstName},<br><br>
            Nous avons bien reçu votre demande.<br><br>
            Nous sommes heureuses de vous informer que votre commande est actuellement en transit. Elle devrait arriver dans les prochains jours, selon les délais de votre transporteur.<br><br>
            Merci pour votre confiance et votre patience.<br>
            N'hésitez pas à nous contacter si vous avez la moindre question.<br><br>
            Avec douceur,<br><br>
            L'équipe SolCotton
          </td>
        </tr>

        <!-- UPDATED FOOTER -->
        <tr>
          <td style="padding:24px 30px;">

            <hr style="border:0; border-top:1px solid #000; margin-bottom:14px;">

            <!-- TAGLINE -->
            <div style="text-align:center; font-size:13px; color:#000; font-style:italic; padding-bottom:12px;">
              Guided by purpose & inspired by simplicity
            </div>

            <!-- WEBSITE LINK -->
            <div style="text-align:center; font-size:14px; padding-bottom:18px;">
              <a href="https://solcotton.com/" target="_blank"
                 style="color:#0066CC; text-decoration:underline;">
                www.solcotton.com
              </a>
            </div>

            <!-- FOLLOW US INLINE -->
            <div style="text-align:center; font-size:13px; color:#000; padding-bottom:10px;">
              <span style="vertical-align:middle;">Suivez-nous :&nbsp;&nbsp;</span>

              <a href="https://www.instagram.com/solcotton.fr/" target="_blank" style="display:inline-block;">
                <img src="https://solmillenium2.my.salesforce-sites.com/resource/instalogo" width="20" height="20" alt="Instagram" style="vertical-align:middle;">
              </a>&nbsp;&nbsp;

              <a href="https://www.facebook.com/profile.php?id=61575728411505" target="_blank" style="display:inline-block;">
                <img src="https://solmillenium2.my.salesforce-sites.com/resource/fblogo" width="20" height="20" alt="Facebook" style="vertical-align:middle;">
              </a>&nbsp;&nbsp;

              <a href="https://www.tiktok.com/@solcottonfrance" target="_blank" style="display:inline-block;">
                <img src="https://solmillenium2.my.salesforce-sites.com/resource/tiktoklogo" width="20" height="20" alt="TikTok" style="vertical-align:middle;">
              </a>
            </div>


            <hr style="border:0; border-top:1px solid #000; margin-top:18px;">

          </td>
        </tr>

      </table>
    </td></tr>

    <tr><td><custom type="footer" /></td></tr>
  </table>

</body>
</html>
