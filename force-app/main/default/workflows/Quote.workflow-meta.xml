<?xml version="1.0" encoding="UTF-8"?>
<Workflow xmlns="http://soap.sforce.com/2006/04/metadata">
    <alerts>
        <fullName>Quote_Approval</fullName>
        <description>Quote Approval</description>
        <protected>false</protected>
        <recipients>
            <recipient>dkumar@solm.com</recipient>
            <type>user</type>
        </recipients>
        <senderType>CurrentUser</senderType>
        <template>unfiled$public/Quote_Approval</template>
    </alerts>
    <alerts>
        <fullName>Quote_Approval_Acknowledge</fullName>
        <description>Quote Approval Acknowledge</description>
        <protected>false</protected>
        <recipients>
            <recipient>dkumar@solm.com</recipient>
            <type>user</type>
        </recipients>
        <senderType>CurrentUser</senderType>
        <template>unfiled$public/Quote_Approval_Submitted</template>
    </alerts>
    <alerts>
        <fullName>Quote_Approved</fullName>
        <description>Quote Approved</description>
        <protected>false</protected>
        <recipients>
            <recipient>dkumar@solm.com</recipient>
            <type>user</type>
        </recipients>
        <senderType>CurrentUser</senderType>
        <template>unfiled$public/Quote_Approved</template>
    </alerts>
    <alerts>
        <fullName>Quote_Rejected</fullName>
        <description>Quote Rejected</description>
        <protected>false</protected>
        <recipients>
            <recipient>dkumar@solm.com</recipient>
            <type>user</type>
        </recipients>
        <senderType>CurrentUser</senderType>
        <template>unfiled$public/Quote_Rejected</template>
    </alerts>
    <fieldUpdates>
        <fullName>If_Appoved</fullName>
        <field>Status</field>
        <literalValue>Approved</literalValue>
        <name>If Appoved</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Literal</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
    </fieldUpdates>
    <fieldUpdates>
        <fullName>If_Rejected</fullName>
        <field>Status</field>
        <literalValue>Rejected</literalValue>
        <name>If Rejected</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Literal</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
    </fieldUpdates>
    <fieldUpdates>
        <fullName>Quote_Update_Name</fullName>
        <field>Name</field>
        <formula>QuoteNumber</formula>
        <name>Quote - Update Name</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Formula</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
    </fieldUpdates>
    <fieldUpdates>
        <fullName>Update_Sent</fullName>
        <field>Status</field>
        <literalValue>In Revision</literalValue>
        <name>Update Sent</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Literal</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
    </fieldUpdates>
    <rules>
        <fullName>Quote - Update Name</fullName>
        <actions>
            <name>Quote_Update_Name</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>Quote.Name</field>
            <operation>equals</operation>
            <value>Autofill</value>
        </criteriaItems>
        <description>When creating and updating the Quotation, the system must update the Quotation Name with the value of the Quotation number.</description>
        <triggerType>onCreateOnly</triggerType>
    </rules>
</Workflow>
